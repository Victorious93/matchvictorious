<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET is needed for the MatchVictorious platform (Supabase). Imports are still parsed on-device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Approximate location only (rounded again to ~1 km before upload). Optional; city fallback exists. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android 13+: asked with an in-app explanation; notifications are generic by default. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice intro recording (user-initiated, max 30 s). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Fleet control: only apps signed with the SAME key may call the fleet API. -->
    <permission
        android:name="com.victorious.match.permission.FLEET_CONTROL"
        android:label="Control MatchVictorious (Victorious fleet)"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.victorious.match.permission.FLEET_CONTROL" />

    <!-- Needed so deep links can check whether the official dating apps are installed. -->
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /></intent>
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="MatchVictorious"
        android:theme="@style/Theme.MatchVictorious">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Fleet OPEN_SCREEN entry point, guarded by the signature permission. -->
        <activity-alias
            android:name=".fleet.OpenScreenAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:permission="com.victorious.match.permission.FLEET_CONTROL">
            <intent-filter>
                <action android:name="com.victorious.match.action.OPEN_SCREEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".fleet.FleetReceiver"
            android:exported="true"
            android:permission="com.victorious.match.permission.FLEET_CONTROL">
            <intent-filter>
                <action android:name="com.victorious.match.action.STATUS" />
                <action android:name="com.victorious.match.action.PING" />
            </intent-filter>
        </receiver>
        <service android:name=".push.MvMessagingService" android:exported="false">
            <intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT" /></intent-filter>
        </service>
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="matches_messages" />
    </application>
</manifest>
